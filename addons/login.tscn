[gd_scene format=3 uid="uid://bfsgt6fsrk103"]

[sub_resource type="GDScript" id="GDScript_t40wv"]
resource_name = "LoginMenu"
script/source = "extends Area2D

var crypto = Crypto.new()

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass

func check_password_and_username(req_type: String):
	var username = $Control/VBoxContainer/Username/LineEdit.text
	var password = $Control/VBoxContainer/Password/LineEdit.text
	
	if password == \"\" or username == \"\":
		$Control/VBoxContainer/ErrorContainer.text = \"Invalid username or password\"
		return

	var salt_bytes: PackedByteArray = crypto.generate_random_bytes(32)
	var salt_hex: String = salt_bytes.hex_encode()
	
	var ctx = HashingContext.new()
	ctx.start(HashingContext.HASH_SHA256)
	ctx.update((password + salt_hex).to_utf8_buffer())
	var safe_password = ctx.finish().hex_encode()

	print(safe_password)
	var body = {
		\"username\": username,
		\"password\": safe_password
	}

	var headers = [\"Content-Type: application/json\"]

func _on_signin_button_up() -> void:
	var req_type = \"signup\"
	check_password_and_username(req_type)

func _on_login_button_up() -> void:
	var req_type = \"login\"
	check_password_and_username(req_type)


func _on_line_edit_text_changed(new_text: String) -> void:
	$Control/VBoxContainer/ErrorContainer.text = \"\"
"

